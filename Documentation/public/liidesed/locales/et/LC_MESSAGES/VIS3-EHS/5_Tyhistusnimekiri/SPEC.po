#: ../../VIS3-EHS/5_Tyhistusnimekiri/SPEC.md:1
msgid "5 Tühistus- ja ennistusnimekiri"
msgstr "Tühistus- ja ennistusnimekiri"

#: ../../VIS3-EHS/5_Tyhistusnimekiri/SPEC.md:3
msgid ""
"VIS3 edastab EHS-le tühistus- ja ennistusnimekirja (lühidalt - "
"tühistusnimekiri)."
msgstr ""

#: ../../VIS3-EHS/5_Tyhistusnimekiri/SPEC.md:5
msgid ""
"Tühistusnimekiri sisaldab andmeid isikute kohta, kelle e-hääl tuleb "
"tühistada (on paberhääletanud ja sellest tulenevalt ei lähe e-hääl "
"arvesse valimistulemuste kokkulugemisel) või ennistada (s.t. tühistatakse"
" eelnev tühistamine ning häälte uuesti üle lugemisel võetakse ennistatud "
"e-hääl arvesse)."
msgstr ""

