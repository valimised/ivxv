{{/* vim: set ft=gotexttmpl: */}}
package {{.Package.Name}}

import "fmt"

{{range .Literals}}
// BEGIN {{.Name}}

// auto-generated from {{base .Pos.String}}.
// ivxv.ee/{{$.Package.ImportPath}}.{{.Name}}
// {{.Comment}}
type {{.Name}} struct {
	{{range .Fields}}
	{{.}} {{if eq . "Err"}}error{{else if eq . "Description"}}string `+"`json:\"-\"`"+`{{else}}interface{}{{end}}
	{{- end}}
}
// END {{.Name}}

// EntryID implements the ivxv.ee/log.Entry interface.
func (x {{.Name}}) EntryID() string { return "ivxv.ee/{{$.Package.ImportPath}}.{{.Name}}" }

{{$name := .Name}}
{{range .Fields}}{{if eq . "Err"}}
// Cause implements the ivxv.ee/errors.Causer interface.
func (x {{$name}}) Cause() error { return x.Err }
{{end}}{{end}}

func (x {{.Name}}) Error() string {
	return fmt.Sprint(x.EntryID(), "{",
		{{- range $i, $e := .Fields -}}
		{{- if gt $i 0}}", ",{{end}}
		{{if ne . "Description"}}"{{.}}:", x.{{.}},{{end}}
		{{- end -}}
		"}")
}
{{end}}
